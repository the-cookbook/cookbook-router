{
  "name": "@cookbook/router-react",
  "version": "0.0.0",
  "description": "React integration for Cookbook Router.",
  "license": "MIT",
  "author": "The Cookbook",
  "homepage": "https://github.com/the-cookbook/cookbook-router#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-cookbook/cookbook-router.git"
  },
  "bugs": {
    "url": "https://github.com/the-cookbook/cookbook-router/issues"
  },
  "keywords": [
    "react",
    "react-router",
    "react-routing",
    "router",
    "routing",
    "typed-router",
    "type-safe-router",
    "type-safe-routing",
    "typed-routes",
    "typescript-router",
    "typescript",
    "hooks",
    "react-hooks",
    "link",
    "navigation",
    "ssr",
    "hydration",
    "url-state",
    "search-params",
    "path-params",
    "route-params",
    "middleware",
    "cookbook-router"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c ../../rollup.config.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "prepack": "pnpm build",
    "test": "vitest --config ../../vitest.config.ts --run",
    "test:coverage": "vitest --config ../../vitest.config.ts --run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cookbook/router": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {}
}
