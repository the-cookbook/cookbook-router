{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "paths": {
      "@cookbook/router": ["../router/src/index.ts"],
      "@cookbook/router/*": ["../router/src/*"]
