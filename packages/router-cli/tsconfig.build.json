{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "paths": {},
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "declarationMap": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test-helpers.ts",
    "dist",
    "node_modules"
  ]
}
