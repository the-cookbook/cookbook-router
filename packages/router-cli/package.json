{
  "name": "@cookbook/router-cli",
  "version": "0.0.0",
  "description": "Developer tooling for Cookbook Router.",
  "license": "MIT",
  "author": "The Cookbook",
  "homepage": "https://github.com/the-cookbook/cookbook-router#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-cookbook/cookbook-router.git"
  },
  "bugs": {
    "url": "https://github.com/the-cookbook/cookbook-router/issues"
  },
  "keywords": [
    "cli",
    "codegen",
    "router-cli",
    "router-codegen",
    "route-codegen",
    "route-contracts",
    "typed-routes",
    "typed-router",
    "type-safe-router",
    "type-safe-routing",
    "typescript-router",
    "typescript",
    "routing",
    "router",
    "navigation",
    "url-state",
    "search-params",
    "path-params",
    "manifest",
    "cookbook-router"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "cbr": "./dist/index.js",
    "cookbook-router": "./dist/index.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c ../../rollup.config.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "prepack": "pnpm build",
    "test": "vitest --config ../../vitest.config.ts --run",
    "test:watch": "vitest --config ../../vitest.config.ts",
    "test:coverage": "vitest --config ../../vitest.config.ts --run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cookbook/router": "workspace:*",
    "ajv": "8.20.0",
    "commander": "^14.0.0"
  }
}
