{
  "name": "@cookbook/router-rspack-plugin",
  "version": "0.0.0",
  "description": "Rspack plugin for Cookbook Router generated route artifacts.",
  "license": "Apache-2.0",
  "author": "The Cookbook",
  "homepage": "https://github.com/the-cookbook/cookbook-router#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-cookbook/cookbook-router.git"
  },
  "bugs": {
    "url": "https://github.com/the-cookbook/cookbook-router/issues"
  },
  "keywords": [
    "rspack",
    "rspack-plugin",
    "router",
    "routing",
    "typed-routes",
    "route-codegen",
    "cookbook-router"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c ../../rollup.config.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "prepack": "pnpm build",
    "test": "vitest --config ../../vitest.config.ts --run",
    "test:coverage": "vitest --config ../../vitest.config.ts --run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@rspack/core": "^1.6.0"
  },
  "peerDependencies": {
    "@rspack/core": ">=1"
  },
  "dependencies": {
    "@cookbook/router-cli": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    }
  }
}
