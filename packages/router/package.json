{
  "name": "@cookbook/router",
  "version": "0.0.0",
  "description": "Framework-agnostic Cookbook Router runtime.",
  "license": "MIT",
  "author": "The Cookbook",
  "homepage": "https://github.com/the-cookbook/cookbook-router#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-cookbook/cookbook-router.git"
  },
  "bugs": {
    "url": "https://github.com/the-cookbook/cookbook-router/issues"
  },
  "keywords": [
    "middleware",
    "pathkit",
    "router",
    "routing",
    "ssr",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup -c ../../rollup.config.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "prepack": "pnpm build",
    "test": "vitest --config ../../vitest.config.ts --run",
    "test:coverage": "vitest --config ../../vitest.config.ts --run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cookbook/pathkit": "v0.2.1"
  },
  "peerDependencies": {},
  "devDependencies": {},
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
