{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "paths": {
      "@cookbook/router": ["../router/src/index.ts"],
      "@cookbook/router/*": ["../router/src/*"],
      "@cookbook/router-cli": ["../router-cli/src/index.ts"],
      "@cookbook/router-cli/*": ["../router-cli/src/*"]
    },
    "types": ["node", "bun-types"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "node_modules"]
}
