{
  "name": "cookbook-router-consumer-trial",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "External consumer trial app for Cookbook Router release validation.",
  "scripts": {
    "generate": "cookbook-router generate --routes ./src/route-config.json --out-dir ./.cookbook-router",
    "validate:routes": "cookbook-router validate --routes ./src/route-config.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom --reporter=dot --pool=forks --maxWorkers=1 --no-file-parallelism",
    "build": "pnpm generate && pnpm validate:routes && pnpm typecheck && vite build",
    "validate:no-deep-imports": "node ./scripts/validate-no-deep-imports.mjs",
    "validate:trial": "pnpm validate:no-deep-imports && pnpm build && pnpm test"
  },
  "dependencies": {
    "@cookbook/router": "file:../packages/router",
    "@cookbook/router-react": "file:../packages/router-react",
    "@cookbook/router-cli": "file:../packages/router-cli",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "@vitejs/plugin-react": "^6.0.2"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9.0.0"
  }
}
