{
  "routes": [
    {
      "id": "root",
      "path": "/",
      "layout": {
        "slots": {
          "sidebar": {
            "component": "TrialSidebarFallback",
            "meta": {
              "title": "Sidebar"
            },
            "routes": [
              {
                "id": "root.sidebar.user",
                "path": "users/{id:int}",
                "component": "UserSidebar",
                "meta": {
                  "title": "User sidebar"
                }
              }
            ]
          },
          "modal": true
        }
      },
      "children": [
        {
          "id": "home",
          "index": true,
          "meta": {
            "title": "Home"
          }
        },
        {
          "id": "users.show",
          "path": "users/{id:int}",
          "search": {
            "tab": {
              "type": "one",
              "optional": true
            },
            "preview": {
              "type": "one",
              "optional": true
            }
          },
          "hash": ["profile", "settings"],
          "meta": {
            "title": "User",
            "requiresAuth": true
          }
        },
        {
          "id": "login",
          "path": "login",
          "meta": {
            "title": "Login"
          }
        },
        {
          "id": "private.dashboard",
          "path": "private",
          "meta": {
            "title": "Private dashboard",
            "requiresAuth": true
          }
        },
        {
          "id": "blog",
          "path": "blog",
          "layout": {
            "slots": {
              "modal": true
            }
          },
          "intercepts": {
            "modal": {
              "to": "blog.posts.show",
              "component": "BlogPostModal"
            }
          },
          "children": [
            {
              "id": "blog.index",
              "index": true,
              "meta": {
                "title": "Blog"
              }
            }
          ]
        },
        {
          "id": "blog.posts.show",
          "path": "/blog/{slug:regex([a-z0-9-]+)}",
          "meta": {
            "title": "Blog post"
          }
        }
      ]
    }
  ]
}
