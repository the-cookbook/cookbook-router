{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@cookbook/router": ["../../packages/router/src/index.ts"],
      "@cookbook/router/*": ["../../packages/router/src/*"],
      "@cookbook/router-react": ["../../packages/router-react/src/index.ts"],
      "@cookbook/router-react/*": ["../../packages/router-react/src/*"],
      "@/*": ["app/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "app",
    ".cookbook-router/contracts.ts",
    ".cookbook-router/register.d.ts"
  ]
}
