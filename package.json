{
  "name": "cookbook-router-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/the-cookbook/cookbook-router.git"
  },
  "bugs": {
    "url": "https://github.com/the-cookbook/cookbook-router/issues"
  },
  "homepage": "https://github.com/the-cookbook/cookbook-router#readme",
  "scripts": {
    "build": "pnpm build:packages",
    "build:examples": "pnpm -r --filter './examples/*' build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "clean": "git clean -fdX packages examples coverage .turbo dist",
    "coverage": "pnpm test:coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm validate:release && changeset publish",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs",
    "lint:examples": "pnpm -r --filter './examples/*' lint",
    "publish:dry-run": "node ./scripts/publish-dry-run.mjs",
    "test": "pnpm -r --filter './packages/*' test",
    "test:ci": "pnpm format:check && pnpm validate:rc && pnpm validate:publish && pnpm validate:exports && pnpm typecheck:all && pnpm lint && pnpm test:coverage && pnpm test:examples && pnpm test:e2e && pnpm build:packages && pnpm build:examples && pnpm publish:dry-run && pnpm test:consumer-trial",
    "test:consumer-trial": "node ./scripts/run-consumer-trial.mjs",
    "test:coverage": "pnpm -r --filter './packages/*' test:coverage",
    "test:e2e": "vitest --config vitest.e2e.config.ts --run",
    "test:examples": "pnpm -r --filter './examples/*' test",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:examples",
    "typecheck:examples": "pnpm -r --filter './examples/*' typecheck",
    "validate:docs-api": "node ./scripts/validate-docs-api.mjs",
    "validate:exports": "node ./scripts/validate-package-exports.mjs",
    "validate:no-blockers": "node ./scripts/validate-no-release-blockers.mjs",
    "validate:publish": "node ./scripts/validate-publish-config.mjs",
    "validate:rc": "node ./scripts/validate-release-candidate.mjs",
    "validate:release": "pnpm validate:rc && pnpm validate:publish && pnpm validate:exports && pnpm typecheck:all && pnpm lint && pnpm test:coverage && pnpm test:e2e && pnpm build:packages && pnpm build:examples && pnpm publish:dry-run && pnpm test:consumer-trial",
    "verify:workspace": "pnpm -r list --depth -1",
    "prepare": "husky",
    "hooks:pre-commit": "pnpm lint-staged && pnpm validate:docs-api && pnpm validate:no-blockers",
    "hooks:pre-push": "pnpm test:ci",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rollup": "^4.62.0",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --check"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --check"
    ]
  }
}
